{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.stokd.cloud/schemas/v1/command.schema.json",
  "title": "Cloud Agent command envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandType",
        "agentId",
        "conversationId",
        "payload",
        "expectedRevision"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "commandType": {
          "const": "conversation.message.admit"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^cnv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "idempotencyKey"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandType",
        "agentId",
        "conversationId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "commandType": {
          "const": "wake.status.get"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^cnv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wakeId"
          ],
          "properties": {
            "wakeId": {
              "type": "string",
              "pattern": "^wak_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandType",
        "agentId",
        "conversationId",
        "payload",
        "expectedRevision"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "commandType": {
          "const": "wake.cancel"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^cnv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wakeId"
          ],
          "properties": {
            "wakeId": {
              "type": "string",
              "pattern": "^wak_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandType",
        "agentId",
        "conversationId",
        "payload",
        "expectedRevision"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "commandType": {
          "const": "approval.respond"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^cnv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalId",
            "actionHash",
            "decision"
          ],
          "properties": {
            "approvalId": {
              "type": "string",
              "pattern": "^apr_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
            },
            "actionHash": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "enum": [
                "approved",
                "denied"
              ]
            }
          }
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandType",
        "agentId",
        "conversationId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "commandType": {
          "const": "artifact.reference.get"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "conversationId": {
          "type": "string",
          "pattern": "^cnv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactId"
          ],
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^art_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
            },
            "versionId": {
              "type": "string",
              "pattern": "^arv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
            }
          }
        }
      }
    }
  ]
}
