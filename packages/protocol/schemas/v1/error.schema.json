{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.stokd.cloud/schemas/v1/error.schema.json",
  "title": "Cloud Agent error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "errorId",
    "code",
    "message",
    "exitCode",
    "retryable"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "errorId": {
      "type": "string",
      "pattern": "^err_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "code": {
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "revision_conflict",
        "runtime_unavailable",
        "unsupported_capability",
        "unsupported_schema_version",
        "unknown_state_changing_event"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "enum": [
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object"
    }
  }
}
