{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.stokd.cloud/schemas/v1/artifact.schema.json",
  "title": "Cloud Agent artifact version descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "versionId",
    "agentId",
    "safeFilename",
    "contentType",
    "byteLength",
    "sha256",
    "objectKey",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^arv_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "safeFilename": {
      "type": "string",
      "minLength": 1
    },
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5368709120
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "objectKey": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "tombstonedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
