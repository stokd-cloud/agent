{
  "name": "@stokd-cloud/agent-storage",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "engines": {
    "node": "24.15.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
