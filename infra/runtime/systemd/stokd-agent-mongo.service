[Unit]
Description=Stokd Agent retained MongoDB 7.0.29
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStart=/opt/stokd-agent/bin/mongo-service
Restart=on-failure
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target

